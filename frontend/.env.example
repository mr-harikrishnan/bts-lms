# Public API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Razorpay Checkout Public Key (Safe for frontend bundle)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyId

# SECURITY NOTE:
# Do NOT add private keys, EmailJS private keys, or webhook secrets here.
# All sensitive credentials belong strictly in backend/.env.

